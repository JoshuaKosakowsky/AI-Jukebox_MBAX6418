#!/bin/sh
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
if [ "$branch" = "main" ] && git rev-parse --verify HEAD >/dev/null 2>&1; then
  if [ "$(git config --bool --get jukebox.soloSetup)" != "true" ]; then
    echo "Commit blocked: use a team task branch, or the authorized solo-setup option in CONTRIBUTING." >&2
    exit 1
  fi
fi
