#!/bin/sh
if [ "$(git config --bool --get jukebox.allowPush)" != "true" ]; then
  echo "Push blocked: this repository is local-only until explicitly authorized." >&2
  exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$(git config --bool --get jukebox.soloSetup)" != "true" ]; then
      echo "Push blocked: team main updates require PRs; see CONTRIBUTING for solo setup." >&2
      exit 1
    fi
    case "$local_oid" in
      *[!0]*) ;;
      *) echo "Push blocked: main deletion is forbidden." >&2; exit 1 ;;
    esac
    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
      echo "Push blocked: solo setup may only fast-forward existing main." >&2
      exit 1
    fi
  fi
done
